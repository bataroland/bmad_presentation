{
  "name": "library-api-java25",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "root",
  "updateRemoteUserUID": false,
  "runArgs": ["--security-opt=label=disable", "--privileged"],
  "forwardPorts": [8081, 8082],
  "portsAttributes": {
    "8081": { "label": "Spring Boot (original/migrated)", "onAutoForward": "notify" },
    "8082": { "label": "Spring Boot (migrated, port override)", "onAutoForward": "silent" }
  },
  "mounts": [
    "source=${localEnv:HOME}/.config/claude,target=/root/.claude,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/root/.config/gh,type=bind",
    "source=library-api-bash-history,target=/root/.bash_history,type=volume",
    "source=library-api-m2-repo,target=/root/.m2,type=volume",
    "source=library-api-vscode-server,target=/root/.vscode-server,type=volume"
  ],
  "postCreateCommand": "dockerd --storage-driver vfs > /tmp/dockerd.log 2>&1 & sleep 3 && docker info > /dev/null 2>&1 && echo 'Docker daemon started' || echo 'WARNING: dockerd failed to start'; mvn dependency:resolve; gh auth setup-git && GH_USER=$(gh api user --jq .login) && GH_NAME=$(gh api user --jq '.name // .login') && git config --global user.name \"$GH_NAME\" && git config --global user.email \"$GH_USER@users.noreply.github.com\" || echo 'WARNING: gh auth failed'",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-spring-boot-dashboard",
        "anthropic.claude-code",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-25",
            "path": "/usr/lib/jvm/msopenjdk-current",
            "default": true
          },
          {
            "name": "JavaSE-1.8",
            "path": "/usr/local/sdkman/candidates/java/8.0.482-tem"
          }
        ]
      }
    }
  }
}
